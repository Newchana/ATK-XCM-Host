<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 单文件可执行、无控制台黑框 -->
    <AssemblyName>XcmHost</AssemblyName>
    <RootNamespace>XcmHost</RootNamespace>
    <Version>1.0.0</Version>
    <Company>XcmHost</Company>
    <Product>ATK-XCM 副屏上位机（自实现）</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- 硬件传感器：CPU/GPU 温度、使用率、网络吞吐 -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <!-- 串口通讯（LibreHardwareMonitor 0.9.4 要求 9.0.0） -->
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
    <!-- WMI 查询（CPU 名、内存）+ 设备插拔监听 -->
    <PackageReference Include="System.Management" Version="9.0.0" />
    <!-- 托盘图标 -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <!-- 开机自启（计划任务） -->
    <PackageReference Include="TaskScheduler" Version="2.12.1" />
  </ItemGroup>

</Project>
